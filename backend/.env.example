# NOTE: the backend actually reads the ROOT `.env` (one level up), not this
# file - see `env_file = "../.env"` in app/core/config.py. Use the root
# `.env.example` as the authoritative template; this file exists only as a
# quick backend-only reference and must stay in sync with it.

DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seat_booking

JWT_SECRET=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# development (default) or production - see main.py's CORS setup.
ENVIRONMENT=development

STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Local-demo convenience only - lets a logged-in user top up their own wallet
# with no real Stripe charge. Must be false in any shared/production environment.
DEMO_WALLET_MODE=false
DEMO_INITIAL_CREDIT_EMAIL=sdkurupudi@intuceo.com
DEMO_INITIAL_CREDIT_AMOUNT=10000.0

ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_AUTHORITY=https://login.microsoftonline.com/common

# Get a key at https://openrouter.ai/keys - the chatbot is reached through
# OpenRouter's OpenAI-API-compatible endpoint, not api.openai.com directly.
OPENROUTER_API_KEY=
# openai/gpt-4o-mini: reliable tool/function calling, very low cost (not literally
# free). A free model like meta-llama/llama-3.3-70b-instruct:free is an option, but
# it was empirically unreliable here on multi-step tool calls (occasionally returned
# nothing at all) - not something to risk on the booking flow. Swap at your own risk.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

FRONTEND_URL=http://localhost:5173
