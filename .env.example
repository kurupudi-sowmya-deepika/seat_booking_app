# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seat_booking

# ==============================================================================
# Security & JWT Token Secrets
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ==============================================================================
# Microsoft Entra ID (SSO & Microsoft Graph Profile Photo API)
# ==============================================================================
VITE_ENTRA_CLIENT_ID=your_entra_client_id
VITE_ENTRA_TENANT_ID=your_entra_tenant_id
VITE_ENTRA_REDIRECT_URI=http://localhost:3000
ENTRA_TENANT_ID=your_entra_tenant_id
ENTRA_CLIENT_ID=your_entra_client_id
ENTRA_CLIENT_SECRET=your_entra_client_secret

# ==============================================================================
# Stripe Payment Gateway
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Lets a logged-in user top up their own wallet with no real Stripe charge.
# Local-demo convenience only - MUST be false (or unset) in any shared/production environment.
DEMO_WALLET_MODE=false
DEMO_INITIAL_CREDIT_EMAIL=sdkurupudi@intuceo.com
DEMO_INITIAL_CREDIT_AMOUNT=10000.0

# ==============================================================================
# Google Gemini / LLM Integration for In-App AI Chatbot
# ==============================================================================
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ==============================================================================
# Model Context Protocol (MCP) Server for External AI (WorkPilot / Intuceo.Ai)
# ==============================================================================
SEAT_BOOKING_API_URL=http://localhost:8000/api
# stdio (default, local subprocess e.g. Claude Desktop) or streamable-http
# (standalone network service another application connects to over HTTP).
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8100
# Every tool call should carry its own employee auth_token (obtained via the
# authenticate_employee tool). Leave this false except for local testing
# convenience - see mcp_server/README.md's "Authentication model" section.
MCP_ALLOW_DEFAULT_IDENTITY=false
# Bearer token every MCP client must send (Authorization: Bearer ...) over streamable-http.
# REQUIRED whenever WORKPILOT_SERVICE_TOKEN is set - the server refuses to start without it.
MCP_AUTH_TOKEN=
# Shared secret with the Seat Booking BACKEND (same var name there). Lets a trusted caller
# (WorkPilot, via this MCP server) act as an EXISTING active employee by email without their
# password. Generate with: openssl rand -hex 32. Empty = feature disabled.
WORKPILOT_SERVICE_TOKEN=
SEAT_BOOKING_USER_EMAIL=
SEAT_BOOKING_USER_PASSWORD=
SEAT_BOOKING_AUTH_TOKEN=
MCP_REQUEST_TIMEOUT=30.0

# ==============================================================================
# Frontend & CORS Configuration
# ==============================================================================
# development (default) or production. Only gates whether localhost origins
# are auto-added to CORS in backend/app/main.py - set production explicitly
# when deploying, so only FRONTEND_URL is trusted.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000,http://localhost:5173
VITE_API_URL=http://localhost:8000/api
