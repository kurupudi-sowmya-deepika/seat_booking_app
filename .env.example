# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seat_booking

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
# Generate a new 32+ character JWT secret with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ==============================================================================
# Microsoft Entra ID (Single Sign-On & Graph API Profile Photos)
# ==============================================================================
ENTRA_TENANT_ID=your_entra_tenant_id
ENTRA_CLIENT_ID=your_entra_client_id
ENTRA_CLIENT_SECRET=your_entra_client_secret
ENTRA_AUTHORITY=https://login.microsoftonline.com/common
VITE_ENTRA_CLIENT_ID=your_entra_client_id
VITE_ENTRA_TENANT_ID=your_entra_tenant_id
VITE_ENTRA_REDIRECT_URI=http://localhost:3000

# ==============================================================================
# Stripe Payment Gateway (Optional - for Wallet Top-ups)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
DEMO_WALLET_MODE=false
DEMO_INITIAL_CREDIT_EMAIL=sdkurupudi@intuceo.com
DEMO_INITIAL_CREDIT_AMOUNT=50000.0

# ==============================================================================
# Google Gemini / LLM Integration (In-App Chatbot Concierge)
# ==============================================================================
# Obtain an API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ==============================================================================
# Model Context Protocol (MCP) Server for External AI (WorkPilot / Intuceo.Ai)
# ==============================================================================
SEAT_BOOKING_API_URL=http://localhost:8000/api

# Transport: "stdio" (local subprocess, e.g. Claude Desktop) or "streamable-http" (network service)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8100
MCP_ALLOW_DEFAULT_IDENTITY=false
MCP_REQUEST_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# MCP SECURITY TOKENS (For Production & Multi-Project Deployment)
# ------------------------------------------------------------------------------
# 1. MCP_AUTH_TOKEN:
#    - Protects the MCP HTTP server endpoint (http://localhost:8100/mcp).
#    - External clients (e.g. WorkPilot) must pass: "Authorization: Bearer <MCP_AUTH_TOKEN>".
#    - To generate a new secure token, run in terminal:
#        openssl rand -hex 32
#      OR in Python:
#        python -c "import secrets; print(secrets.token_hex(32))"
MCP_AUTH_TOKEN=your_generated_mcp_auth_token_here

# 2. WORKPILOT_SERVICE_TOKEN:
#    - Shared secret between the SpaceHub Backend and MCP Server.
#    - Enables trusted machine-to-machine actions on behalf of active employees by email
#      (passing X-Service-Token + X-On-Behalf-Of-Email).
#    - Must match between backend and MCP server containers.
#    - To generate a new secure token, run in terminal:
#        openssl rand -hex 32
#      OR in Python:
#        python -c "import secrets; print(secrets.token_hex(32))"
WORKPILOT_SERVICE_TOKEN=your_generated_workpilot_service_token_here

# ==============================================================================
# Frontend & CORS Configuration
# ==============================================================================
# "development" locally (auto-permits localhost); "production" when deployed
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000,http://localhost:5173
VITE_API_URL=http://localhost:8000/api
